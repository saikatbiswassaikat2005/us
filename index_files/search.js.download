/* eslint-env browser, jquery */
/* global Drupal, once */

(function ($, Drupal, once) {
  'use strict';

  Drupal.behaviors.uchSsdSearch = {
    /**
     * Attach search interactions to the current context.
     * @param {Document|HTMLElement} context
     * @returns {void}
     */
    attach: function (context) {
      // Toggle department search input and direct focus on activation.
      once('uch-ssd-dept-search', '.form-control-btn', context).forEach((button) => {
        const toggleSearch = () => {
          $('.search-key').toggleClass('show-search');
          $('input#search-keywords').focus();
        };

        $(button)
          .on('click.uchSsdSearch', toggleSearch)
          .on('keypress.uchSsdSearch', function (e) {
            if (e.which === 13) {
              toggleSearch();
            }
          });
      });
    }
  };
})(window.jQuery, Drupal, once);
