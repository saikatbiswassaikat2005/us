/* eslint-env browser, jquery */
/* global Drupal, once */

(function ($, Drupal, once) {
  'use strict';

  /**
   * Update the banner state based on existing consent.
   * @param {jQuery} $banner
   * @returns {void}
   */
  function updateBannerVisibility($banner) {
    const hasConsent = document.cookie.indexOf('accepted_cookies=') >= 0;
    if (hasConsent) {
      $banner.removeClass('d-block').addClass('d-none');
    } else {
      $banner.removeClass('d-none').addClass('d-block');
    }
  }

  Drupal.behaviors.uchSsdGdpr = {
    /**
     * Attach cookie banner handlers for the current context.
     * @param {Document|HTMLElement} context
     * @returns {void}
     */
    attach: function (context) {
      once('uch-ssd-gdpr-banner', '.cookie-notice-container', context)
        .forEach((banner) => {
          updateBannerVisibility($(banner));
        });

      once('uch-ssd-gdpr-accept', 'a#cn-accept-cookie', context)
        .forEach((link) => {
          $(link).on('click.uchSsdGdpr', function (event) {
            event.preventDefault();
            document.cookie = 'accepted_cookies=yes;';
            $('.cookie-notice-container').removeClass('d-block').addClass('d-none');
          });
        });
    }
  };
})(window.jQuery, Drupal, once);
