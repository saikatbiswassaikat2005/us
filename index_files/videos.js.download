/* eslint-env browser, jquery */
/* global Drupal, YT, Vimeo, once */

/**
 * Wire video controls into Drupal behaviors.
 * @param {jQuery} $
 * @param {Drupal} Drupal
 * @param {Function} once
 * @returns {void}
 */
(function ($, Drupal, once) {
  'use strict';

  /**
   * Map iframes to YouTube player instances.
   * @type {Map<HTMLIFrameElement, YT.Player>}
   */
  const ytPlayers = new Map();
  /**
   * Map iframes to Vimeo player instances.
   * @type {Map<HTMLIFrameElement, Vimeo.Player>}
   */
  const vimeoPlayers = new Map();
  /**
   * Cache the YouTube API loading promise to avoid duplicate requests.
   * @type {Promise<unknown>|null}
   */
  let youtubeApiPromise = null;
  /**
   * Cache the Vimeo API loading promise to avoid duplicate requests.
   * @type {Promise<unknown>|null}
   */
  let vimeoApiPromise = null;

  /**
   * Update the icon and accessibility state for a toggle button.
   * @param {HTMLElement} button
   * @param {boolean} isPlaying
   * @returns {void}
   */
  function updateButtonIcon(button, isPlaying) {
    button.innerHTML = isPlaying
      ? '<i class="fas fa-pause" aria-hidden="true"></i>'
      : '<i class="fas fa-play" aria-hidden="true"></i>';
    button.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
    button.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video');
  }

  /**
   * Update the toggle button icon that corresponds to an iframe embed.
   * @param {HTMLIFrameElement} iframe
   * @param {boolean} isPlaying
   * @returns {void}
   */
  function updateButtonIconForIframe(iframe, isPlaying) {
    const container = iframe.closest('.video-embed');
    if (!container || !container.parentElement) {
      return;
    }

    const button = container.parentElement.querySelector('.video-toggle-button');
    if (!button) {
      return;
    }

    updateButtonIcon(button, isPlaying);
  }

  /**
   * Hide the overlay that sits on top of a YouTube embed.
   * @param {HTMLIFrameElement} iframe
   * @returns {void}
   */
  function hideYouTubeOverlay(iframe) {
    const container = iframe.closest('.video-embed.youtube');
    if (!container || !container.parentElement) {
      return;
    }

    const overlay = container.parentElement.querySelector('.full-inner-container');
    if (overlay) {
      overlay.hidden = true;
    }
  }

  /**
   * Show the overlay that sits on top of a YouTube embed.
   * @param {HTMLIFrameElement} iframe
   * @returns {void}
   */
  function showYouTubeOverlay(iframe) {
    const container = iframe.closest('.video-embed.youtube');
    if (!container || !container.parentElement) {
      return;
    }

    const overlay = container.parentElement.querySelector('.full-inner-container');
    if (overlay) {
      overlay.hidden = false;
    }
  }

  /**
   * Load the Vimeo Player API once and return a promise for it.
   * @returns {Promise<unknown>}
   */
  function ensureVimeoApi() {
    if (window.Vimeo && window.Vimeo.Player) {
      return Promise.resolve(window.Vimeo);
    }

    if (!vimeoApiPromise) {
      vimeoApiPromise = new Promise((resolve, reject) => {
        $.getScript('https://player.vimeo.com/api/player.js')
          .done(() => resolve(window.Vimeo))
          .fail(() => reject(new Error('Vimeo API failed to load.')));
      });
    }

    return vimeoApiPromise;
  }

  /**
   * Load the YouTube iframe API once and return a promise for it.
   * @returns {Promise<unknown>}
   */
  function ensureYouTubeApi() {
    if (window.YT && window.YT.Player) {
      return Promise.resolve(window.YT);
    }

    if (!youtubeApiPromise) {
      youtubeApiPromise = new Promise((resolve, reject) => {
        const existingCallback = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = function () {
          if (typeof existingCallback === 'function') {
            existingCallback();
          }
          resolve(window.YT);
        };

        $.getScript('https://www.youtube.com/iframe_api')
          .fail(() => reject(new Error('YouTube API failed to load.')));
      });
    }

    return youtubeApiPromise;
  }

  /**
   * Initialize the toggle button for a given video container (HTML5, Vimeo, or YouTube).
   * @param {HTMLElement} button
   * @returns {void}
   */
  function initVideoToggle(button) {
    const container = button.parentElement.querySelector('.video-bg, .video-embed');
    if (!container) return;

    const video = container.querySelector('video');
    const iframe = container.querySelector('iframe');

    button.setAttribute('role', 'button');
    button.setAttribute('tabindex', '0');

    /**
     * Determine whether the current video is playing.
     * @returns {Promise<boolean>}
     */
    async function isPlaying() {
      if (video) return !video.paused && !video.ended;
      if (iframe && vimeoPlayers.has(iframe)) {
        try {
          return !(await vimeoPlayers.get(iframe).getPaused());
        } catch {
          return false;
        }
      }
      if (iframe && ytPlayers.has(iframe)) {
        try {
          return ytPlayers.get(iframe).getPlayerState() === YT.PlayerState.PLAYING;
        } catch {
          return false;
        }
      }
      return false;
    }

    /**
     * Update the icon inside the toggle button to match play/pause state.
     * @param {boolean} playing
     * @returns {void}
     */
    function updateIcon(playing) {
      updateButtonIcon(button, playing);
    }

    /**
     * Toggle playback state for the associated video.
     * @returns {Promise<void>}
     */
    async function togglePlayback() {
      const playing = await isPlaying();
      if (video) {
        if (playing) video.pause(); else video.play();
      } else if (iframe && vimeoPlayers.has(iframe)) {
        const player = vimeoPlayers.get(iframe);
        if (playing) player.pause(); else player.play();
      } else if (iframe && ytPlayers.has(iframe)) {
        const player = ytPlayers.get(iframe);
        if (playing) player.pauseVideo(); else player.playVideo();
      }

      setTimeout(async () => {
        updateIcon(await isPlaying());
      }, 200);
    }

    button.addEventListener('click', togglePlayback);
    button.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        togglePlayback();
      }
    });

    if (video) {
      video.addEventListener('play', () => updateIcon(true));
      video.addEventListener('pause', () => updateIcon(false));
    }

    setTimeout(async () => {
      updateIcon(await isPlaying());
    }, 200);

  }

  /**
   * Create and configure a Vimeo player for the provided iframe.
   * @param {HTMLIFrameElement} iframe
   * @returns {void}
   */
  function initVimeoPlayer(iframe) {
    if (vimeoPlayers.has(iframe)) {
      return;
    }

    const player = new Vimeo.Player(iframe);
    vimeoPlayers.set(iframe, player);

    player.on('play', () => updateButtonIconForIframe(iframe, true));
    player.on('pause', () => updateButtonIconForIframe(iframe, false));

    Promise.all([player.getVideoWidth(), player.getVideoHeight()])
      .then(([width, height]) => {
        if (!width || !height) {
          return;
        }
        const container = iframe.closest('.video-embed');
        if (container) {
          container.style.aspectRatio = width + ' / ' + height;
        }
      })
      .catch(() => {});
  }

  /**
   * Create and configure a YouTube player for the provided iframe.
   * @param {HTMLIFrameElement} iframe
   * @returns {void}
   */
  function initYouTubePlayer(iframe) {
    if (ytPlayers.has(iframe)) {
      return;
    }

    const player = new YT.Player(iframe, {
      events: {
        onStateChange: (event) => {
          const isPlaying = event.data === YT.PlayerState.PLAYING;
          updateButtonIconForIframe(iframe, isPlaying);

          if (isPlaying) {
            showYouTubeOverlay(iframe);
          } else if (event.data === YT.PlayerState.PAUSED) {
            hideYouTubeOverlay(iframe);
          }
        }
      }
    });

    ytPlayers.set(iframe, player);
  }

  Drupal.behaviors.videoControls = {
    /**
     * Attach video behavior to new DOM context elements.
     * @param {Document|HTMLElement} context
     * @returns {void}
     */
    attach: function (context) {
      once('video-toggle', '.video-toggle-button', context)
        .forEach(button => initVideoToggle(button));

      const vimeoIframes = once('vimeo-player', '.video-embed.vimeo iframe', context);
      if (vimeoIframes.length) {
        ensureVimeoApi()
          .then(() => {
            vimeoIframes.forEach(iframe => initVimeoPlayer(iframe));
          })
          .catch(() => {});
      }

      const youtubeIframes = once('youtube-player', '.video-embed.youtube iframe', context);
      if (youtubeIframes.length) {
        ensureYouTubeApi()
          .then(() => {
            youtubeIframes.forEach(iframe => initYouTubePlayer(iframe));
          })
          .catch(() => {});
      }
    }
  };
})(window.jQuery, Drupal, once);
